{
  "mcpServers": {
    "agent-fleet": {
      "command": "/usr/local/bin/agent-mcp-server",
      "env": {
        "AGENT_FLEET_MCP_OWNER": "VerdifyConsultancy",
        "AGENT_FLEET_MCP_NAME": "verdify-platform",
        "AGENT_FLEET_MCP_GITHUB_IDENTITY": "VerdifyConsultancy",
        "AGENT_FLEET_MCP_DASHBOARD_URL": "http://agent-fleet-dashboard.agent-fleet-dashboard.svc.cluster.local:8080",
        "AGENT_FLEET_MCP_CALLBACK_TOKEN_FILE": "/etc/agent-fleet/mcp-callback-token",
        "LAYOUT_PATH": "/var/lib/agent-state/layout.live.json"
      }
    },
    "brave-search": {
      "command": "brave-search-mcp-server",
      "args": ["--transport", "stdio"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    }
  }
}
