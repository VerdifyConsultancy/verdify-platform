# syntax=docker/dockerfile:1.7
# Verdify lab publisher - Quartz + Python generators for k3s.
#
# Build context is the repo root. The runtime container syncs content/public
# artifacts with S3-compatible object storage and writes the live public tree to
# the lab cache PVC mounted at /work/public.

FROM node:22-bookworm-slim AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
      awscli \
      ca-certificates \
      coreutils \
      curl \
      git \
      postgresql-client \
      python3 \
      python3-pip \
      python3-venv \
      rsync \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
      'asyncpg>=0.29,<1' \
      'httpx>=0.27,<1' \
      'pydantic>=2.8,<3' \
      'python-dotenv>=1.0,<2' \
      'pyyaml>=6.0,<7'

WORKDIR /opt/verdify-site
COPY site/package.json site/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY site/ /app/site/
COPY scripts/ /app/scripts/
COPY ingestor/ /app/ingestor/
COPY mcp/ /app/mcp/
COPY firmware/ /app/firmware/
COPY verdify_schemas/ /app/verdify_schemas/
COPY slack_config.py slack.yaml /app/
COPY slack_ops/ /app/slack_ops/

RUN cp -a /app/site/quartz /app/site/docs \
      /app/site/package.json /app/site/package-lock.json \
      /app/site/quartz.config.ts /app/site/quartz.layout.ts \
      /app/site/tsconfig.json /app/site/globals.d.ts \
      /app/site/index.d.ts /app/site/nginx.conf /opt/verdify-site/ \
    && install -m 0755 /app/scripts/lab-publish-k3s.sh /usr/local/bin/lab-publish-k3s \
    && install -m 0755 /app/scripts/lab-publisher-docker-shim.sh /usr/local/bin/docker \
    && chmod +x /app/scripts/*.sh \
    && mkdir -p /srv/verdify/verdify-site /srv/verdify /mnt/iris/verdify-vault /work \
    && chown -R 1000:1000 /opt/verdify-site /app /srv/verdify /mnt/iris /work

USER 1000:1000
ENV HOME=/home/node \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/ingestor:/app \
    LAB_WORK_ROOT=/work

ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG GIT_REF=unknown
ENV VERDIFY_GIT_SHA=$GIT_SHA \
    VERDIFY_BUILD_TIME=$BUILD_TIME \
    VERDIFY_GIT_REF=$GIT_REF
LABEL org.opencontainers.image.source="https://github.com/VerdifyConsultancy/verdify-platform" \
      org.opencontainers.image.revision=$GIT_SHA \
      org.opencontainers.image.created=$BUILD_TIME \
      org.opencontainers.image.title="verdify-lab-publisher"

CMD ["lab-publish-k3s"]
