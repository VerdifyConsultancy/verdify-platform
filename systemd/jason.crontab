# Verdify Scheduled Tasks
# Install with: crontab systemd/jason.crontab
# All times are local host time (America/Denver on vm-docker-iris).

# DB backup to NFS (1:00 AM)
0 1 * * * docker exec verdify-timescaledb pg_dump -U verdify -Fc verdify > /mnt/iris/backups/verdify-$(date +\%Y\%m\%d).dump 2>> /srv/verdify/state/backup.log

# Daily summary finalization (12:05 AM)
5 0 * * * /srv/verdify/scripts/daily-summary-snapshot.py >> /srv/verdify/state/daily-snapshot.log 2>&1

# Vault daily summary (12:10 AM)
10 0 * * * /srv/verdify/scripts/vault-daily-writer.py >> /srv/verdify/state/vault-writer.log 2>&1

# Vault crop records + hydro map (12:15 AM)
15 0 * * * /srv/verdify/scripts/vault-crop-writer.py >> /srv/verdify/state/vault-crop.log 2>&1
15 0 * * * /srv/verdify/scripts/generate-hydro-map.py >> /srv/verdify/state/hydro-map.log 2>&1

# Frigate camera snapshots (12 PM, 4 PM, 8 PM, 12 AM)
0 12,16,20,0 * * * /srv/verdify/scripts/frigate-snapshot.py >> /srv/verdify/state/frigate-snapshot.log 2>&1

# Daily checklist to Slack (1 PM)
0 13 * * * /srv/verdify/scripts/checklist-to-slack.sh >> /srv/verdify/state/checklist-slack.log 2>&1

# Verdify Prometheus metrics (every 1 min)
* * * * * /srv/verdify/scripts/verdify-metrics.py 2>/dev/null

# Slack channel archive (every 6 hours)
0 */6 * * * /srv/verdify/scripts/slack-channel-archive.py >> /srv/verdify/state/slack-archive.log 2>&1

# Plan publishing to verdify.ai (after SUNRISE, SUNSET, and end-of-day)
0 7 * * * /srv/verdify/scripts/publish-daily-plan.sh >> /srv/verdify/state/publish.log 2>&1
15 20 * * * /srv/verdify/scripts/publish-daily-plan.sh >> /srv/verdify/state/publish.log 2>&1
30 0 * * * /srv/verdify/scripts/publish-daily-plan.sh "$(date -d yesterday +\%Y-\%m-\%d)" >> /srv/verdify/state/publish.log 2>&1
