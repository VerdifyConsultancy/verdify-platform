[Unit]
Description=Verdify Grafana mobile render cache warmer
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jason
WorkingDirectory=/srv/verdify
ExecStart=/srv/greenhouse/.venv/bin/python /srv/verdify/scripts/warm-grafana-render-cache.py --buckets 800 --workers 1 --timeout 90 --retries 2 --retry-delay 10 --failure-threshold-pct 5
