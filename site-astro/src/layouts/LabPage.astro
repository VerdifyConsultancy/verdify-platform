---
import "../../.generated/site-shell-root/vendor/verdify-site-shell/styles/global.css";
import katexStylesheet from "katex/dist/katex.min.css?url";
import "../styles/global.css";

import Breadcrumbs from "../../.generated/site-shell-root/vendor/verdify-site-shell/components/Breadcrumbs.astro";
import Footer from "../../.generated/site-shell-root/vendor/verdify-site-shell/components/Footer.astro";
import Header from "../../.generated/site-shell-root/vendor/verdify-site-shell/components/Header.astro";
import LabNavigation from "../components/LabNavigation.astro";
import MediaLightbox from "../components/MediaLightbox.astro";
import PageEnhancements from "../components/PageEnhancements.astro";
import { navigation } from "../data/navigation";
import { build, latestPlan, type ContentRecord } from "../lib/content";

interface Props {
  record: ContentRecord;
}

const { record } = Astro.props;
const hasHeading = /<h1(?:\s|>)/i.test(record.html);
const hasMath = /class="katex(?:["\s])/i.test(record.html);
const robots = build.stageGlobalNoindex || record.noindex || record.kind === "alias" ? "noindex,follow" : "index,follow";
const socialTitle = `${record.title} — Verdify Lab`;
const socialDescription = record.description || "Verdify public greenhouse evidence.";
const socialImage = new URL(record.socialImage || "/static/og-image-v2.jpg", build.siteOrigin).href;
const groups = navigation(latestPlan?.canonicalPath ?? "/data/plans/");
const classes = ["lab-article", ...record.cssclasses].join(" ");
const pageFamily = (() => {
  if (record.route === "/") return "home";
  if (record.route === "/data/plans") return "archive";
  if (record.route === "/data/forecast") return "forecast";
  if (record.route === "/data/operations") return "operations";
  if (record.route === "/start/evidence") return "evidence";
  if (record.route === "/start/contact") return "contact";
  if (record.route.startsWith("/plans/")) return "plan";
  if (record.route.startsWith("/reference/")) return "reference";
  if (record.route.startsWith("/greenhouse/")) return "greenhouse";
  return "article";
})();
const corporateOrigin = "https://verdify.ai";
const shellProps = {
  currentSite: "lab" as const,
  corporateOrigin,
  labOrigin: build.siteOrigin,
  brand: "lab" as const,
  homeHref: "/",
};
const segments = record.route.split("/").filter(Boolean);
const breadcrumbItems = [
  { name: "Lab", href: "/" },
  ...segments.map((segment, index) => ({
    name: index === segments.length - 1 ? record.title : segment.replaceAll("-", " "),
    href: `/${segments.slice(0, index + 1).join("/")}`,
  })),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={socialDescription} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={record.kind === "alias" ? `${build.siteOrigin}${record.target}` : record.canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/assets/verdify-lab-lockup.svg" type="image/svg+xml" />
    <link rel="canonical" href={record.kind === "alias" ? `${build.siteOrigin}${record.target}` : record.canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Verdify Lab" />
    {hasMath && <link rel="stylesheet" href={katexStylesheet} />}
    {record.kind === "alias" && <meta http-equiv="refresh" content={`0; URL='${record.target}'`} />}
    <title>{socialTitle}</title>
  </head>
  <body class={`site-page lab-page lab-page--${pageFamily}`} data-page-family={pageFamily}>
    <a class="skip-link" href="#lab-content">Skip to Lab content</a>
    <Header {...shellProps} />
    <div class="stage-banner" role="status">
      Stage preview · globally noindex · known frozen-baseline integrity blockers remain open · no production authority
    </div>
    {record.route !== "/" && record.kind !== "alias" && <Breadcrumbs items={breadcrumbItems} {...shellProps} />}
    <div class="lab-frame">
      <LabNavigation groups={groups} currentRoute={record.route} />
      <main id="lab-content" class="lab-main" tabindex="-1">
        <article class={classes} data-pagefind-body data-pagefind-meta={`title:${record.title}`}>
          {!hasHeading && <h1>{record.title}</h1>}
          {
            record.kind === "alias" ? (
              <div class="redirect-card">
                <p>This route moved.</p>
                <a href={record.target}>Continue to {record.target}</a>
              </div>
            ) : (
              <div set:html={record.html} />
            )
          }
          {
            record.tags.length > 0 && (
              <footer class="article-tags" aria-label="Topics">
                {record.tags.map((tag) => <a href={`/tags/${tag.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`}>{tag}</a>)}
              </footer>
            )
          }
        </article>
        <p class="stage-provenance">
          Stage snapshot <code>{build.snapshotManifestDigest.slice(0, 23)}…</code> · {build.localEvidenceStatus} · not approval evidence
        </p>
      </main>
    </div>
    <MediaLightbox />
    <PageEnhancements pageFamily={pageFamily} />
    <Footer {...shellProps} />
    <script is:inline>
      (() => {
        const snapshots = [...document.querySelectorAll("img[data-camera-local-src]")];
        if (!snapshots.length) return;

        const refresh = () => {
          for (const snapshot of snapshots) {
            const source = snapshot.getAttribute("data-camera-local-src");
            if (!source) continue;
            const target = new URL(source, window.location.href);
            if (target.origin !== window.location.origin || !target.pathname.startsWith("/static/cameras/")) continue;
            target.searchParams.set("refresh", String(Date.now()));
            const candidate = new Image();
            candidate.onload = () => {
              snapshot.src = target.href;
              snapshot.dataset.cameraState = "fresh";
              snapshot.removeAttribute("title");
            };
            candidate.onerror = () => {
              snapshot.dataset.cameraState = "last-known-good";
              snapshot.title = "Showing the last verified snapshot; the latest refresh was unavailable.";
            };
            candidate.src = target.href;
          }
        };

        window.setInterval(refresh, 30_000);
      })();
    </script>
  </body>
</html>
