# syntax=docker/dockerfile:1.7
FROM node:22.22.0-alpine3.22@sha256:7eb2c0c4b8cf6fd761f0e6a7fed8d3b8ad59186848f0eee59744e546f1b6a3e9 AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN test "$(node --version)" = "v22.22.0" \
    && test "$(npm --version)" = "10.9.4" \
    && npm ci --no-audit --no-fund

FROM dependencies AS build
COPY . .

# These values are intentionally not ARGs. A production image cannot be built
# for an alternate origin or with a global noindex override accidentally left on.
ENV LAB_SNAPSHOT=.snapshot \
    ALLOW_SYNTHETIC_FIXTURE=false \
    LAB_BUILD_TARGET=production \
    SITE_ORIGIN=https://lab.verdify.ai \
    STAGE_GLOBAL_NOINDEX=false \
    NODE_ENV=production
RUN test -f .snapshot/attestation.json && npm run build:production

FROM nginxinc/nginx-unprivileged:1.29.3-alpine@sha256:f7d0d0f2ebc0486dc110278672b9073f7fd641e58376b112b0c8865cf36d2e36 AS runtime

LABEL org.opencontainers.image.title="Verdify Lab Astro production candidate" \
      org.opencontainers.image.description="Approval-gated static production candidate; carries no device or publishing authority" \
      ai.verdify.environment="production" \
      ai.verdify.release-track="green" \
      ai.verdify.device-authority="none"

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers-production.inc /etc/nginx/conf.d/security-headers.inc
COPY --from=build /app/dist/ /usr/share/nginx/html/

USER 101:101
EXPOSE 8080
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
