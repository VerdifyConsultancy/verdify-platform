{
  "name": "@verdify/lab-astro-stage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "scripts": {
    "shell:prepare": "node scripts/prepare-site-shell.mjs",
    "snapshot:hydrate": "node scripts/fetch-stage-snapshot.mjs --release vendor/snapshot/verdify-lab-stage-20260712t1620z.json --destination .snapshot",
    "snapshot:verify": "node scripts/verify-stage-snapshot.mjs --release vendor/snapshot/verdify-lab-stage-20260712t1620z.json",
    "compile": "node scripts/compile-snapshot.mjs",
    "occurrence:status": "node scripts/manage-occurrence-release.mjs status",
    "occurrence:freshness": "node scripts/manage-occurrence-release.mjs freshness",
    "occurrence:publish": "node scripts/manage-occurrence-release.mjs publish",
    "occurrence:rollback": "node scripts/manage-occurrence-release.mjs rollback",
    "occurrence:media:status": "node scripts/manage-occurrence-release.mjs media-status",
    "occurrence:media:publish": "node scripts/manage-occurrence-release.mjs publish-media",
    "occurrence:media:rollback": "node scripts/manage-occurrence-release.mjs rollback-media",
    "occurrence:export": "node scripts/prepare-occurrence-export.mjs",
    "camera:export": "node scripts/export-camera-occurrence.mjs capture",
    "site-release:prepare": "node scripts/manage-site-release.mjs prepare",
    "site-release:publish": "node scripts/manage-site-release.mjs publish",
    "site-release:status": "node scripts/manage-site-release.mjs status",
    "site-release:rollback": "node scripts/manage-site-release.mjs rollback",
    "site-release:bundle": "node scripts/manage-site-release.mjs bundle",
    "site-release:hydrate": "node scripts/manage-site-release.mjs hydrate",
    "check": "node scripts/build-stage.mjs --check",
    "build": "node scripts/build-stage.mjs",
    "build:fixture": "LAB_SNAPSHOT=tests/fixtures/snapshot ALLOW_SYNTHETIC_FIXTURE=true SITE_ORIGIN=https://lab-stage.verdify.ai npm run build",
    "build:production": "node scripts/build-production.mjs",
    "build:production:fixture": "node scripts/build-production.mjs --fixture",
    "test:unit": "node --test tests/build-lock.test.mjs tests/camera-export-producer.test.mjs tests/compiler.test.mjs tests/graph-export-producer.test.mjs tests/manifests.test.mjs tests/occurrence-export.test.mjs tests/occurrence-release.test.mjs tests/site-release.test.mjs tests/snapshot-hydrator.test.mjs",
    "test:parity": "python3 -m unittest discover -s tests -p 'test_site_build_parity_limits.py'",
    "test:manifests:stage": "kubectl kustomize ../deploy/k8s/overlays/lab-stage | node scripts/verify-rendered-stage.mjs",
    "test:manifests:production": "kubectl kustomize ../deploy/k8s/candidates/lab-astro-production | node scripts/verify-rendered-production-candidate.mjs",
    "test:manifests": "npm run test:manifests:stage && npm run test:manifests:production",
    "test:output": "node --test tests/output.test.mjs",
    "playwright:ensure": "node scripts/ensure-playwright-browser.mjs",
    "test:browser": "npm run build:fixture && npm run playwright:ensure && playwright test --config=playwright.config.mjs",
    "test:quality:built": "npm run playwright:ensure && playwright test --config=playwright.config.mjs --grep @quality",
    "test:quality": "npm run build:fixture && npm run test:quality:built",
    "test:production:output": "node --test tests/production-output.test.mjs",
    "test:production": "npm run build:production:fixture && npm run test:production:output",
    "test": "npm run test:unit && npm run test:parity && npm run test:manifests && npm run build:fixture && npm run test:output && npm run test:quality:built && npm run test:production",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:real": "node scripts/verify-real-build.mjs",
    "verify:production": "node scripts/verify-production-output.mjs",
    "parity:manifest": "python3 scripts/site-build-parity.py manifest dist -o astro-manifest.json --origin ${SITE_ORIGIN:-https://lab-stage.verdify.ai}",
    "parity:compare": "python3 scripts/site-build-parity.py compare ${QUARTZ_MANIFEST:?set QUARTZ_MANIFEST} astro-manifest.json -o parity-report.json",
    "parity:compare:provisional": "python3 scripts/site-build-parity.py compare ${QUARTZ_MANIFEST:?set QUARTZ_MANIFEST} astro-manifest.json --allow-provisional -o parity-report.json"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "astro": "6.4.8",
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.5",
    "pagefind": "1.5.2",
    "postcss": "8.5.14",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.2",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "typescript": "5.9.3"
  }
}
