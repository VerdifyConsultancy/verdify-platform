{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdify.dev/schemas/design-lock-v2.schema.json",
  "title": "Verdify protocol-v2 pre-draw design lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment_namespace_uuid",
    "design_lock_sha256",
    "pairs",
    "schedule_schema_sha256",
    "source_git_sha",
    "start_local_date",
    "study_id",
    "timezone"
  ],
  "properties": {
    "assignment_namespace_uuid": {"type": "string", "format": "uuid"},
    "design_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pairs": {"type": "integer", "minimum": 1},
    "schedule_schema_sha256": {
      "const": "fc73d212f58db91bd55bb70e3faa1431172b4339ae3b22a11d404ba95147b794"
    },
    "source_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "start_local_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "study_id": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1}
  }
}
