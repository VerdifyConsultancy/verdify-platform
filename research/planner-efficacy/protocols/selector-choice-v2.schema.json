{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdify.dev/schemas/selector-choice-v2.schema.json",
  "title": "Verdify protocol-v2 persisted daily virtual selector choice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted_at",
    "attempt_receipt_sha256",
    "choice_id",
    "context_sha256",
    "fallback_reason",
    "identity_sha256",
    "invocation_key",
    "local_date",
    "profile",
    "raw_request_sha256",
    "raw_response_sha256",
    "study_id"
  ],
  "properties": {
    "accepted_at": {"type": "string", "format": "date-time"},
    "attempt_receipt_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "choice_id": {"type": "string", "format": "uuid"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fallback_reason": {"type": ["string", "null"]},
    "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "invocation_key": {"type": "string", "format": "uuid"},
    "local_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "profile": {"enum": ["baseline", "moderate", "aggressive"]},
    "raw_request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_response_sha256": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "study_id": {"type": "string", "minLength": 1}
  }
}
