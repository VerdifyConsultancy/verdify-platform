# Verdify image build context (repo root) — exclusions.
#
# Build context spans the repo root because api/mcp/ingestor each COPY the
# shared repo-root packages (verdify_schemas/, slack_config.py, slack_ops/).
# This file trims the context to keep builds fast and the images clean. Keep in
# sync with the COPY lines in api/Dockerfile, mcp/Dockerfile, ingestor/Dockerfile.

# --- VCS / tooling metadata ---
.git
.gitignore
.github
.editorconfig
.pre-commit-config.yaml
.stignore

# --- caches / build junk (never belongs in an image) ---
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.ruff_cache
**/.mypy_cache
__pycache__

# --- heavy trees, mostly image-irrelevant ---
# Firmware is ESP32 C++/ESPHome + a ~193k-row replay corpus. Python service
# images never ship it; the lab-publisher image needs only the public tunable
# YAML contract read by scripts/generate-ai-tunables-page.py.
firmware
!firmware
firmware/*
!firmware/greenhouse
firmware/greenhouse/*
!firmware/greenhouse/controls.yaml
!firmware/greenhouse/globals.yaml
!firmware/greenhouse/sensors.yaml
!firmware/greenhouse/tunables.yaml
# Quartz static site + its build output.
site
!site
site/*
!site/package.json
!site/package-lock.json
!site/quartz.config.ts
!site/quartz.layout.ts
!site/tsconfig.json
!site/globals.d.ts
!site/index.d.ts
!site/nginx.conf
!site/quartz
!site/quartz/**
site/quartz/.quartz-cache
site/node_modules
!site/docs
!site/docs/**
# Long-form docs / design / audits — not runtime.
docs

# --- other infra dirs not needed by the api/mcp/ingestor images ---
grafana
launch
templates
config
db
hermes

# db/ is excluded above (the api/mcp/ingestor images never touch it), but the
# verdify-migrate image (db/Dockerfile.migrate) COPYs exactly two files out of
# it: db/schema.sql and db/migrations/000-fresh-schema-hypertable-repair.sql.
# Re-include only those — keep the other ~156 migrations, init/, @eaDir, and the
# restore manifests out of every build context. Order matters: these negations
# MUST follow the `db` exclusion line above. The intermediate `!db/migrations`
# + `db/migrations/*` dance is required because Docker won't restore a file
# inside a directory that is itself still excluded by an ancestor pattern.
!db/schema.sql
!db/migrations
db/migrations/*
!db/migrations/000-fresh-schema-hypertable-repair.sql

# --- secrets / local env (NEVER bake into an image; secrets come from k8s) ---
.env
.env.*
!.env.example
**/.env
**/.env.*
**/secrets.yaml
**/*.key
**/*.pem

# --- the throwaway/dev scratch + worktree artifacts ---
.claude
.claude-tmp
.claude-agents

# --- top-level docs the images don't need ---
*.md
# The lab-publisher image builds Quartz from site/docs Markdown; this negation
# must remain after the repo-wide Markdown exclusion above.
!site/docs
!site/docs/**
!verdify_schemas/README.md
README.md
GOAL.md
CONTEXT.md
SLACK.md
CLAUDE.md
AGENTS.md

# --- repo-level python tooling config not needed at runtime ---
.venv
venv

# NOTE: deliberately NOT ignored (the images COPY these):
#   api/  mcp/  ingestor/  verdify_schemas/  slack_config.py  slack_ops/  slack.yaml
# (slack.yaml is non-secret config — channel IDs + credential file paths, not tokens.)
