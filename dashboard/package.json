{
  "name": "verdify-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "build": "react-router build",
    "start": "node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contract:write": "pnpm --dir contract-tools install --frozen-lockfile --ignore-scripts --reporter=silent && node contract-tools/generate.mjs --write",
    "contract:check": "pnpm --dir contract-tools install --frozen-lockfile --ignore-scripts --reporter=silent && node contract-tools/generate.mjs --check"
  },
  "dependencies": {
    "@react-router/express": "8.5.0",
    "@react-router/node": "8.5.0",
    "@tanstack/react-query": "5.104.5",
    "express": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@react-router/dev": "8.5.0",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.3",
    "typescript-eslint": "8.72.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.0",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "supertest": "7.3.1"
  }
}
