{
  "name": "verdify-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "build": "react-router build",
    "start": "node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm fixtures:settings && vitest run",
    "test:browser": "node e2e/verify-browser-tools.mjs && pnpm fixtures:settings && pnpm build && playwright test --project=chromium screenshots.spec.ts; code=$?; sleep 45; exit $code",
    "fixtures:settings": "uv run --no-project --with 'pydantic>=2.8,<3' --with 'pyyaml>=6,<7' python ../scripts/gen-dashboard-settings-fixture.py",
    "contract:write": "pnpm --dir contract-tools install --frozen-lockfile --ignore-scripts --reporter=silent && node contract-tools/generate.mjs --write",
    "contract:check": "pnpm --dir contract-tools install --frozen-lockfile --ignore-scripts --reporter=silent && node contract-tools/generate.mjs --check"
  },
  "dependencies": {
    "@react-router/express": "8.5.0",
    "@react-router/node": "8.5.0",
    "@tanstack/react-query": "5.104.5",
    "express": "5.2.1",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "uplot": "1.6.32",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "8.5.0",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.3",
    "jsdom": "30.1.3",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.0",
    "yaml": "2.9.1"
  }
}
