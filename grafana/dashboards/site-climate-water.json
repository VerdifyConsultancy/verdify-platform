      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT $__time((date + time '12:00')::timestamptz), attributed_gal AS \"Meter-attributed (gal)\", ambiguous_gal AS \"Ambiguous overlap (gal)\", manual_or_unattributed_gal AS \"Manual / unattributed (gal)\", quality_filtered_meter_gal AS \"Accepted meter total (gal)\" FROM v_water_attribution_daily WHERE $__timeFilter((date + time '12:00')::timestamptz) AND available_for_scoring ORDER BY date",
          "refId": "A"
        }
      ],
      "title": "Meter-Conserving Water Attribution",
