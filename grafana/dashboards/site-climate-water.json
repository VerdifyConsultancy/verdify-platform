      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Quality-filtered meter gallons \u00d7 $0.00484/gal. Stale, incomplete, discontinuous, or non-conserving days are excluded rather than replaced with raw counter arithmetic.",
      "transparent": true
    },
