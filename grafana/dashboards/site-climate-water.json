    {
      "id": 8,
      "type": "stat",
      "title": "Eligible Water $/Day (30d)",
      "datasource": {
        "uid": "verdify-tsdb",
        "type": "grafana-postgresql-datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "uid": "verdify-tsdb",
            "type": "grafana-postgresql-datasource"
          },
          "rawSql": "SELECT now() AS time, ROUND(AVG(quality_filtered_meter_gal * 0.00484)::numeric, 2) AS v FROM v_water_attribution_daily WHERE date >= current_date - interval '30 days' AND date < current_date AND available_for_scoring",
          "format": "table",
          "refId": "A"
