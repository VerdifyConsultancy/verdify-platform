          "rawSql": "SELECT now() AS time, ROUND(SUM(quality_filtered_meter_gal * 0.00484)::numeric, 2) AS v FROM v_water_attribution_daily WHERE $__timeFilter((date + time '12:00')::timestamptz) AND available_for_scoring",
          "format": "table",
          "refId": "A"
