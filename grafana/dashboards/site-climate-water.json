      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Average water-only cost for completed, conserving, quality-eligible ledger days. Energy costs are a separate modeled scope.",
      "transparent": true
    },
    {
      "description": "Eligible meter gallons partitioned into single-run attribution, ambiguous overlap, and manual/unattributed remainder. The components conserve the meter total; unavailable/degraded days are excluded and command-only relay runs are never gallons.",
