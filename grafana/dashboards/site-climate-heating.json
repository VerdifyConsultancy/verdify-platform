      "targets": [
        {
          "datasource": {
            "uid": "verdify-tsdb",
            "type": "grafana-postgresql-datasource"
          },
          "rawSql": "SELECT (day::date + time '12:00')::timestamptz AS time,\n  MAX(on_minutes) FILTER (WHERE equipment='heat1')/60.0 AS \"Heat 1\",\n  MAX(on_minutes) FILTER (WHERE equipment='heat2')/60.0 AS \"Heat 2\",\n  MAX(on_minutes) FILTER (WHERE equipment='fan1')/60.0 AS \"Fan 1\",\n  MAX(on_minutes) FILTER (WHERE equipment='fan2')/60.0 AS \"Fan 2\",\n  MAX(on_minutes) FILTER (WHERE equipment='fog')/60.0 AS \"Fog\",\n  MAX(on_minutes) FILTER (WHERE equipment='vent')/60.0 AS \"Vent\",\n  MAX(on_minutes) FILTER (WHERE equipment IN ('grow_light_main','grow_light_grow'))/60.0 AS \"Grow Lights\",\n  MAX(on_minutes) FILTER (WHERE equipment='mister_south')/60.0 AS \"Mister South\",\n  MAX(on_minutes) FILTER (WHERE equipment='mister_west')/60.0 AS \"Mister West\",\n  MAX(on_minutes) FILTER (WHERE equipment='mister_center')/60.0 AS \"Mister Center\"\nFROM mv_equipment_runtime_daily WHERE is_deploy_gate_eligible AND $__timeFilter((day::date + time '12:00')::timestamptz) GROUP BY day ORDER BY day",
          "format": "time_series",
          "refId": "A"
        }
      ],
