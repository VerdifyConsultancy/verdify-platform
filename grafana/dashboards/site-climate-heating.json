    {
      "id": 21,
      "type": "timeseries",
      "title": "Gas Therms vs Outdoor Temperature",
      "datasource": {
        "uid": "verdify-tsdb",
        "type": "grafana-postgresql-datasource"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "datasource": {
            "uid": "verdify-tsdb",
            "type": "grafana-postgresql-datasource"
          },
          "rawSql": "SELECT (date + time '12:00')::timestamptz AS time, therms AS \"Therms\"\nFROM mv_daily_kpi WHERE $__timeFilter((date + time '12:00')::timestamptz) AND resource_terms_available ORDER BY date",
          "format": "time_series",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "verdify-tsdb",
            "type": "grafana-postgresql-datasource"
          },
          "rawSql": "SELECT (k.date + time '12:00')::timestamptz AS time, ROUND(AVG(m.outdoor_temp_f)::numeric,1) AS \"Outdoor Temp\"\nFROM mv_daily_kpi k JOIN v_climate_merged m ON m.bucket::date = k.date\nWHERE $__timeFilter((k.date + time '12:00')::timestamptz) AND k.resource_terms_available GROUP BY k.date ORDER BY k.date",
          "format": "time_series",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false,
            "axisLabel": "\u00b0F"
          },
          "unit": "fahrenheit"
        },
        "overrides": [
