              "options": "Outdoor Temp"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "fahrenheit"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "#8C8C8C",
                  "mode": "fixed"
                }
              }
            ]
