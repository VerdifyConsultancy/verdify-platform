    {
      "id": 60,
      "type": "timeseries",
      "title": "Fog Runtime vs RH",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "rawSql": "SELECT $__time(date::timestamptz), runtime_fog_min AS \"Fog (min)\" FROM daily_summary WHERE $__timeFilter((date::timestamptz + interval '12 hours')) ORDER BY date",
          "refId": "A",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT $__time(ts), rh_avg AS \"RH %\" FROM climate WHERE $__timeFilter(ts) AND rh_avg IS NOT NULL ORDER BY ts",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RH %"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ],
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "spanNulls": false
          }
        }
      },
      "description": "Shows fog runtime against relative humidity response.",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 61,
      "type": "timeseries",
      "title": "Ventilation Runtime (air exchange)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "targets": [
        {
          "rawSql": "SELECT $__time(date::timestamptz), runtime_vent_min AS \"Vent (min)\" FROM daily_summary WHERE $__timeFilter((date::timestamptz + interval '12 hours')) ORDER BY date",
          "refId": "A",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT $__time(date::timestamptz), runtime_fan1_min + runtime_fan2_min AS \"Fans (min)\" FROM daily_summary WHERE $__timeFilter((date::timestamptz + interval '12 hours')) ORDER BY date",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "min",
          "custom": {
            "drawStyle": "bars",
