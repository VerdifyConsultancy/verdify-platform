{
  "compilerOptions": {
    "lib": ["esnext", "DOM", "DOM.Iterable"],
    "experimentalDecorators": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "incremental": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "quartz/**/*.ts",
    "quartz/**/*.tsx",
    "quartz.config.ts",
    "quartz.layout.ts",
    "globals.d.ts",
    "index.d.ts",
    "./package.json"
  ],
  "exclude": ["build/**/*.d.ts", "content/**", "public/**", ".builds/**", "node_modules/**"]
}
