# syntax=docker/dockerfile:1
# verdify-migrate: the real schema-build image (replaces the non-existent
# ghcr.io/jvallery/verdify-py:latest the staging proof hit as ImagePullBackOff).
# A thin psql client carrying the production schema snapshot + the hypertable
# repair migration. Used ONLY by deploy/k8s/base/migration-job.yaml (ArgoCD
# PreSync hook) against the IN-CLUSTER verdify-db StatefulSet. It never touches
# the device or the live VM DB. The CREATE EXTENSION timescaledb / create_hypertable
# calls in schema.sql run server-side on the timescale StatefulSet, so a vanilla
# pg16 psql client is sufficient. Build context = repo root.
#
# The migrate script lives at db/migrate.sh (2026-07-11: it was inline via a
# BuildKit COPY heredoc, which Kaniko does NOT support — the in-cluster zot
# build failed with exit 1. The old reason for inlining, an unreliable
# NFS-backed worktree, retired with the VM).
FROM postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
# python3: exact wrap-safety classification for the ledgered runner (#583).
# asyncpg also lets the one-container direct-launch bootstrap reuse this
# repeatedly proven psql image instead of allocating an API-image pod shape
# that failed CNI sandbox creation on every worker.
RUN apk add --no-cache python3 py3-asyncpg
COPY db/schema.sql /db/schema.sql
COPY db/migrations/000-fresh-schema-hypertable-repair.sql /db/000-fresh-schema-hypertable-repair.sql
# Ledgered populated-DB delivery path (#583, audit §8.7): the full numbered
# migration set + ledger DDL/backfill + the runner. Inert unless the Job sets
# VERDIFY_MIGRATE_LEDGER=1 (Lane F flips that flag in GitOps, not this image).
COPY db/migrations/ /db/migrations/
COPY db/ledger/ /db/ledger/
COPY db/apply-migrations.sh /usr/local/bin/apply-migrations.sh
COPY scripts/check_migration_rollback_safety.py /scripts/check_migration_rollback_safety.py
COPY db/migrate.sh /usr/local/bin/migrate.sh
RUN chmod 0755 /usr/local/bin/migrate.sh /usr/local/bin/apply-migrations.sh \
    && chmod 0644 /db/*.sql \
    && find /db/migrations /db/ledger -type f -exec chmod 0644 {} + \
    && chmod 0644 /scripts/check_migration_rollback_safety.py
USER 1000:1000
ENV VERDIFY_MIGRATIONS_DIR=/db/migrations \
    VERDIFY_LEDGER_DIR=/db/ledger \
    VERDIFY_SAFETY_CLASSIFIER=/scripts/check_migration_rollback_safety.py
ENTRYPOINT ["/usr/local/bin/migrate.sh"]
